@@ -37,6 +41,20 @@
         RemainAfterExit = "yes";
       };
     };
+
+    systemd.services.wireguard-firewall = {
+      description = "Open WireGuard port dynamically";
+      wantedBy = [ "network-pre.target" ];
+      before = [ "wg-quick-wg0.service" "systemd-networkd.service" ];
