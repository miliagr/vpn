# Server address (IP or hostname). One block per host in hosts/hosts.json.
# Host names are <datacenter>-<country>-n-<number>; variables are the name upper-cased with "-" -> "_" (aeza-de-n-1 -> AEZA_DE_N_1_*).
AEZA_DE_N_1_ADDR=203.0.113.10

# Shared UUID for VLESS. For per-device revocation, replace with multiple UUIDs later.
VLESS_UUID=

# REALITY target. Use a stable TLS 1.3-capable site reachable from the VPS.
REALITY_DEST=www.microsoft.com:443
REALITY_SERVER_NAME=www.microsoft.com

# Per-server REALITY keypairs / short IDs (for VLESS+REALITY)
AEZA_DE_N_1_REALITY_PRIVATE_KEY=
AEZA_DE_N_1_REALITY_PUBLIC_KEY=
AEZA_DE_N_1_SHORT_ID=

# Per-server WireGuard keypair
AEZA_DE_N_1_WG_PRIVATE_KEY=
AEZA_DE_N_1_WG_PUBLIC_KEY=

UNIVERSAL_PORT=443
XHTTP_PORT=8443
XHTTP_PATH=/api/v1/sync

# Adding a server: add it to hosts/hosts.json, then add <NAME>_ADDR here (e.g. hetzner-fi-n-1 -> HETZNER_FI_N_1_ADDR).
# ./scripts/generate-secrets.sh fills <NAME>_REALITY_* and <NAME>_WG_* keypairs.
