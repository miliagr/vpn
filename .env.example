# VPS addresses (IP or hostname)
VPS1_ADDR=203.0.113.10
VPS2_ADDR=198.51.100.20

# Shared family UUID. For per-device revocation, replace with multiple UUIDs later.
VLESS_UUID=

# REALITY target. Use a stable TLS 1.3-capable site reachable from the VPS.
REALITY_DEST=www.microsoft.com:443
REALITY_SERVER_NAME=www.microsoft.com

# Per-server REALITY keypairs / short IDs
VPS1_REALITY_PRIVATE_KEY=
VPS1_REALITY_PUBLIC_KEY=
VPS1_SHORT_ID=
VPS2_REALITY_PRIVATE_KEY=
VPS2_REALITY_PUBLIC_KEY=
VPS2_SHORT_ID=

UNIVERSAL_PORT=443
XHTTP_PORT=8443
XHTTP_PATH=/api/v1/sync

# Adding a server: add it to hosts/hosts.json, then add <NAME>_ADDR here (NAME = upper-case host key, e.g. VPS3_ADDR).
# ./scripts/generate-secrets.sh fills <NAME>_REALITY_* and <NAME>_SHORT_ID.
# UNIVERSAL_PORT/XHTTP_PORT must match familyVpn.universalPort/xhttpPort in nix/xray.nix (defaults 443/8443).
